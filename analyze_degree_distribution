import numpy as np
import matplotlib.pyplot as plt
from collections import Counter
from scipy import stats, optimize
import warnings
warnings.filterwarnings('ignore')

def analyze_degree_distribution_improved(G, title, use_log_binning=True, num_bins=30):
    """
    Улучшенный анализ распределения степеней с лог-биннингом
    и различными методами оценки степенного закона
    
    Parameters:
    -----------
    G : networkx.Graph
        Граф для анализа
    title : str
        Название для графиков
    use_log_binning : bool
        Использовать ли лог-биннинг для визуализации
    num_bins : int
        Количество бинов для лог-биннинга
    """
    
    # Извлекаем узлы пользователей и групп
    user_nodes = [n for n, d in G.nodes(data=True) if d['bipartite'] == 0]
    group_nodes = [n for n, d in G.nodes(data=True) if d['bipartite'] == 1]
    
    user_degrees = np.array([G.degree(node) for node in user_nodes])
    group_degrees = np.array([G.degree(node) for node in group_nodes])
    
    # Функция для лог-биннинга
    def log_binning(degrees, num_bins=num_bins, density=True):
        """Выполняет лог-биннинг распределения степеней"""
        degrees = degrees[degrees > 0]  # Игнорируем нулевые степени
        if len(degrees) == 0:
            return np.array([]), np.array([])
        
        # Определяем границы бинов в логарифмической шкале
        min_deg, max_deg = np.min(degrees), np.max(degrees)
        log_min, log_max = np.log10(min_deg), np.log10(max_deg)
        bin_edges = np.logspace(log_min, log_max, num_bins + 1)
        
        # Вычисляем гистограмму с логарифмическими бинами
        hist, bin_edges = np.histogram(degrees, bins=bin_edges)
        
        # Вычисляем центры бинов
        bin_centers = np.sqrt(bin_edges[:-1] * bin_edges[1:])  # Среднее геометрическое
        
        # Нормализуем для получения плотности вероятности
        if density:
            hist = hist.astype(float)
            bin_widths = bin_edges[1:] - bin_edges[:-1]
            hist = hist / (bin_widths * hist.sum())
        
        # Фильтруем ненулевые бины
        mask = hist > 0
        return bin_centers[mask], hist[mask]
    
    # Функция для оценки степенного закона методом максимального правдоподобия
    def estimate_powerlaw_mle(degrees):
        """
        Оценка параметров степенного закона методом максимального правдоподобия.
        Возвращает gamma, xmin, D (статистика KS)
        """
        degrees = degrees[degrees > 0]
        if len(degrees) < 10:
            return None, None, None
        
        # Ищем оптимальный xmin путем минимизации расстояния KS
        unique_degrees = np.sort(np.unique(degrees))
        n_unique = len(unique_degrees)
        
        if n_unique < 5:
            return None, None, None
        
        best_ks = np.inf
        best_gamma = None
        best_xmin = unique_degrees[0]
        
        for i, xmin_candidate in enumerate(unique_degrees[:n_unique//2]):
            # Выбираем хвост распределения
            tail = degrees[degrees >= xmin_candidate]
            n = len(tail)
            
            if n < 10:  # Слишком мало точек для оценки
                continue
            
            # Оценка gamma методом максимального правдоподобия
            gamma_mle = 1 + n / np.sum(np.log(tail / xmin_candidate))
            
            # Вычисляем эмпирическую и теоретическую CDF
            ks = np.sort(tail)
            cdf_empirical = np.arange(1, n + 1) / n
            cdf_theoretical = 1 - (ks / xmin_candidate) ** (-gamma_mle + 1)
            
            # Статистика Колмогорова-Смирнова
            ks_stat = np.max(np.abs(cdf_empirical - cdf_theoretical))
            
            if ks_stat < best_ks:
                best_ks = ks_stat
                best_gamma = gamma_mle
                best_xmin = xmin_candidate
        
        return best_gamma, best_xmin, best_ks
    
    # Функция для вычисления R² с учетом лог-биннинга
    def calculate_r_squared_log(x_data, y_data, slope, intercept):
        """Вычисление R² для логарифмических данных"""
        y_pred = slope * x_data + intercept
        ss_res = np.sum((y_data - y_pred) ** 2)
        ss_tot = np.sum((y_data - np.mean(y_data)) ** 2)
        return 1 - ss_res / ss_tot if ss_tot != 0 else 0
    
    # Создаем графики
    fig, axes = plt.subplots(2, 2, figsize=(14, 12))
    ax1, ax2 = axes[0, 0], axes[0, 1]  # Линейный масштаб
    ax3, ax4 = axes[1, 0], axes[1, 1]  # Логарифмический масштаб
    
    # Словари для хранения результатов
    results = {}
    
    # Анализ для пользователей
    print("=" * 50)
    print(f"Degree Distribution Analysis: {title}")
    print("=" * 50)
    
    for idx, (degrees, node_type, color, label) in enumerate([
        (user_degrees, 'user', 'blue', 'Users'),
        (group_degrees, 'group', 'red', 'Groups')
    ]):
        if len(degrees) == 0:
            continue
            
        # Базовые статистики
        degrees_nonzero = degrees[degrees > 0]
        results[f'{node_type}_mean'] = np.mean(degrees)
        results[f'{node_type}_median'] = np.median(degrees)
        results[f'{node_type}_max'] = np.max(degrees)
        results[f'{node_type}_min'] = np.min(degrees)
        
        # 1. Гистограмма в линейном масштабе
        ax = ax1 if node_type == 'user' else ax2
        ax.hist(degrees, bins=50, alpha=0.7, color=color, density=True, edgecolor='black')
        ax.set_xlabel('Degree k')
        ax.set_ylabel('Probability P(k)')
        ax.set_title(f'{label} - Linear scale')
        ax.grid(True, alpha=0.3)
        
        # 2. Логарифмический масштаб с лог-биннингом
        ax_log = ax3 if node_type == 'user' else ax4
        ax3.set_ylim(bottom=5e-5)
        ax4.set_ylim(bottom=2e-4)
        # Сырые данные
        degree_count = Counter(degrees_nonzero)
        x_raw = np.array(list(degree_count.keys()))
        y_raw = np.array(list(degree_count.values()))
        y_raw_norm = y_raw / y_raw.sum()
        
        ax_log.loglog(x_raw, y_raw_norm, 'o', color=color, alpha=0.5, 
                     label='Real data', markersize=4)
        
        # Лог-биннинг
        if use_log_binning and len(degrees_nonzero) > 10:
            x_bin, y_bin = log_binning(degrees_nonzero, num_bins=num_bins, density=True)
            if len(x_bin) > 3:
                #ax_log.loglog(x_bin, y_bin, 's-', color='dark' + color, 
                 #           linewidth=2, markersize=6, label='Log binning')
                
                # Линейная регрессия на данных лог-биннинга
                mask = (x_bin > 0) & (y_bin > 0)
                if mask.sum() > 3:
                    x_log = np.log10(x_bin[mask])
                    y_log = np.log10(y_bin[mask])
                    
                    slope, intercept, r_value, p_value, std_err = stats.linregress(x_log, y_log)
                    gamma = -slope
                    r_squared = r_value**2
                    
                    # Линия регрессии
                    x_fit = np.logspace(np.log10(x_bin[mask].min()), 
                                       np.log10(x_bin[mask].max()), 100)
                    y_fit = 10**intercept * x_fit**slope
                    
                    ax_log.loglog(x_fit, y_fit, 'k--', linewidth=2, 
                                label=f'Regression (γ={gamma:.2f}, R²={r_squared:.3f})')
                    
                    results[f'{node_type}_gamma_logbin'] = gamma
                    results[f'{node_type}_r2_logbin'] = r_squared
                    results[f'{node_type}_pvalue_logbin'] = p_value
        
        # MLE оценка степенного закона
        gamma_mle, xmin_mle, ks_stat = estimate_powerlaw_mle(degrees)
        if gamma_mle is not None:
            # Отображаем xmin на графике
            #ax_log.axvline(x=xmin_mle, color='green', linestyle=':', 
             #            linewidth=2, alpha=0.7, label=f'xmin={xmin_mle}')
            
            # Отображаем степенной закон с MLE оценкой
            x_tail = np.logspace(np.log10(xmin_mle), np.log10(degrees.max()), 100)
            C = (gamma_mle - 1) * xmin_mle**(gamma_mle - 1)
            y_tail = C * x_tail**(-gamma_mle)
            
           # ax_log.loglog(x_tail, y_tail, 'g-', linewidth=2, 
            #            label=f'MLE: γ={gamma_mle:.2f}, D={ks_stat:.3f}')
            
            results[f'{node_type}_gamma_mle'] = gamma_mle
            results[f'{node_type}_xmin_mle'] = xmin_mle
            results[f'{node_type}_ks_mle'] = ks_stat
        
        ax_log.set_xlabel('Degree k')
        ax_log.set_ylabel('Probability P(k)')
        ax_log.set_title(f'{label} - Logarithmic scale')
        ax_log.legend(loc='best', fontsize=9)
        ax_log.grid(True, alpha=0.3)
        
        # Вывод статистики
        print(f"\n{label.upper()}:")
        print(f"  Количество узлов: {len(degrees)}")
        print(f"  Средняя степень: {results[f'{node_type}_mean']:.2f}")
        print(f"  Медиана степени: {results[f'{node_type}_median']:.2f}")
        print(f"  Макс/Мин степень: {results[f'{node_type}_max']}/{results[f'{node_type}_min']}")
        
        if f'{node_type}_gamma_mle' in results:
            print(f"  MLE оценка: γ = {results[f'{node_type}_gamma_mle']:.2f}, "
                  f"xmin = {results[f'{node_type}_xmin_mle']}, KS = {results[f'{node_type}_ks_mle']:.3f}")
        
        if f'{node_type}_gamma_logbin' in results:
            print(f"  Лог-биннинг: γ = {results[f'{node_type}_gamma_logbin']:.2f}, "
                  f"R² = {results[f'{node_type}_r2_logbin']:.3f}")
    
    # Общая статистика сети
    print(f"\n{'='*50}")
    print("ОБЩАЯ СТАТИСТИКА СЕТИ:")
    print(f"  Всего узлов: {G.number_of_nodes()}")
    print(f"  Пользователей: {len(user_nodes)}")
    print(f"  Групп: {len(group_nodes)}")
    print(f"  Всего ребер: {G.number_of_edges()}")
    print(f"  Плотность сети: {2*G.number_of_edges()/(len(user_nodes)*len(group_nodes)):.6f}")
    
    plt.tight_layout()
    plt.savefig('g1.png', dpi=300, bbox_inches='tight')
    plt.show()
    
    return results

# Дополнительная функция для сравнения различных методов оценки
def compare_powerlaw_methods(degrees, label):
    """
    Сравнивает различные методы оценки показателя степенного закона
    """
    degrees = degrees[degrees > 0]
    if len(degrees) < 20:
        print(f"Недостаточно данных для {label}")
        return
    
    print(f"\nСравнение методов для {label}:")
    print("-" * 40)
    
    # 1. Линейная регрессия на сырых данных
    degree_count = Counter(degrees)
    x = np.array(list(degree_count.keys()))
    y = np.array(list(degree_count.values()))
    y_norm = y / y.sum()
    
    mask = (x > 0) & (y_norm > 0)
    if mask.sum() > 3:
        slope, intercept, r_value, p_value, _ = stats.linregress(np.log10(x[mask]), np.log10(y_norm[mask]))
        gamma_raw = -slope
        r2_raw = r_value**2
        print(f"1. Сырые данные: γ={gamma_raw:.2f}, R²={r2_raw:.3f}, p={p_value:.2e}")
    
    # 2. Лог-биннинг + линейная регрессия
    def log_binning_simple(data, num_bins=20):
        data = data[data > 0]
        bin_edges = np.logspace(np.log10(data.min()), np.log10(data.max()), num_bins + 1)
        hist, _ = np.histogram(data, bins=bin_edges)
        bin_centers = np.sqrt(bin_edges[:-1] * bin_edges[1:])
        hist_norm = hist.astype(float) / hist.sum()
        mask = hist_norm > 0
        return bin_centers[mask], hist_norm[mask]
    
    x_bin, y_bin = log_binning_simple(degrees, num_bins=20)
    if len(x_bin) > 3:
        slope, intercept, r_value, p_value, _ = stats.linregress(np.log10(x_bin), np.log10(y_bin))
        gamma_bin = -slope
        r2_bin = r_value**2
        print(f"2. Лог-биннинг: γ={gamma_bin:.2f}, R²={r2_bin:.3f}, p={p_value:.2e}")
    
    # 3. Метод максимального правдоподобия
    def mle_simple(data):
        data = data[data > 0]
        # Используем медиану как xmin для простоты
        xmin = np.median(data)
        tail = data[data >= xmin]
        n = len(tail)
        if n > 10:
            gamma_mle = 1 + n / np.sum(np.log(tail / xmin))
            return gamma_mle, xmin
        return None, None
    
    gamma_mle_simple, xmin_simple = mle_simple(degrees)
    if gamma_mle_simple:
        print(f"3. MLE (упрощ.): γ={gamma_mle_simple:.2f}, xmin={xmin_simple:.1f}")
    
    # 4. Метод моментов
    if len(degrees) > 10:
        k_mean = np.mean(degrees)
        k_sq_mean = np.mean(degrees**2)
        if k_sq_mean > 2 * k_mean**2:
            gamma_moments = 1 + (k_mean**2) / (k_sq_mean - k_mean**2)
            print(f"4. Метод моментов: γ={gamma_moments:.2f}")

